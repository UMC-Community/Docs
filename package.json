{
  "name": "umc-docs",
  "private": true,
  "type": "module",
  "description": "Documentation site for UMC — Universal Minecraft Core",
  "scripts": {
    "docs:sync": "node scripts/sync-docs.mjs && node scripts/i18n-sync.mjs",
    "docs:i18n:status": "node scripts/i18n-status.mjs",
    "docs:dev": "npm run docs:sync && vitepress dev .",
    "docs:build": "npm run docs:sync && vitepress build .",
    "docs:preview": "vitepress preview ."
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
